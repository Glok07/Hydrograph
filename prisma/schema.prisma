generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Lang {
  fr
  fon
  goun
  yoruba
}

enum Channel {
  whatsapp
  sms
}

enum NotifStatus {
  pending
  sent
  delivered
  read
  failed
}

model Subscriber {
  id            String         @id @default(cuid())
  name          String
  /// E.164 sans « + », ex. 2290146910055
  phone         String         @unique
  zone          String
  lang          Lang           @default(fr)
  channel       Channel        @default(whatsapp)
  members       Int            @default(4)
  /// seuls les testeurs réels reçoivent de vrais messages
  real          Boolean        @default(false)
  consent       Boolean        @default(false)
  verifiedAt    DateTime?
  unsubscribedAt DateTime?
  joinedAt      DateTime       @default(now())
  notifications Notification[]

  @@index([zone])
}

model NetworkEvent {
  id        String         @id @default(cuid())
  type      String
  startsAt  Int
  durationH Int
  pipe      String?
  createdAt DateTime       @default(now())
  notifications Notification[]
}

model Notification {
  id           String        @id @default(cuid())
  subscriber   Subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  subscriberId String
  event        NetworkEvent? @relation(fields: [eventId], references: [id])
  eventId      String?
  zone         String
  text         String
  status       NotifStatus   @default(pending)
  /// identifiant du message côté Meta (wamid...)
  providerId   String?
  error        String?
  createdAt    DateTime      @default(now())
  sentAt       DateTime?

  @@index([subscriberId])
  @@index([status])
}

model NetworkZone {
  /// identifiant stable, ex. "Z1" (voir ZoneId dans src/data/network.ts)
  id         String   @id
  name       String
  households Int
  /// demande par créneau de 2 h, hors pointe
  demand     Int
  /// nombre de sauts de conduite depuis le château d'eau
  depth      Int
  /// zone alimentée en partie par des puits : sensible aux fortes pluies
  wells      Boolean
  updatedAt  DateTime @updatedAt
}

model NetworkPipe {
  /// identifiant stable, ex. "P0" (voir PipeId dans src/data/network.ts)
  id   String @id
  /// "TOWER" ou l'id d'une zone
  from String
  to   String
}

model TowerConfig {
  /// une seule ligne : le château d'eau simulé, le point principal de distribution
  id       Int    @id @default(1)
  name     String
  capacity Int
  /// position sur la carte ; absente tant que personne ne l'a placée depuis la plateforme
  lng      Float?
  lat      Float?
}

model HistoryPoint {
  id    String   @id @default(cuid())
  zone  String
  date  DateTime @db.Date
  hours Float

  @@unique([zone, date])
  @@index([zone])
}

model VerificationCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}
